# Copy to .env and fill in real values. Never commit .env.
# Variables without a default in application.properties (marked REQUIRED) must be set.

# --- Database ---
# JDBC URL used when running the app on the host (compose overrides it for the app container).
# Default if unset: in-memory H2.
DB_URL=jdbc:postgresql://localhost:5432/nova_bank
DB_USERNAME=myuser
# REQUIRED by compose (also used as POSTGRES_PASSWORD). Optional for the default in-memory H2.
DB_PASSWORD=change-me
# Postgres database name and published host port (compose only).
DB_NAME=nova_bank
DB_PORT=5432

# --- Server (optional) ---
# SERVER_PORT=8080   # port the app listens on (default 8080)
# APP_PORT=8080      # host port published by compose (default 8080)

# --- JPA (optional) ---
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=true

# --- Mail ---
# compose ships a local Mailpit SMTP server: emails are captured and shown at
# http://localhost:8025. With compose, leave these unset to use Mailpit.
# Running the app on the host against Mailpit: MAIL_HOST=localhost, MAIL_PORT=1025,
# MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false.
# For a real SMTP server set all of them (auth and STARTTLS usually true).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
MAIL_FROM=noreply@localhost
# Mailpit published ports (compose only)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

RECOVERY_PASS_URL=http://localhost:8080/

# --- Security ---
# REQUIRED. Base64 key of at least 256 bits.
JWT_SECRET=change-me-base64-key-of-at-least-256-bits
JWT_EXPIRATION=3600000

# --- External APIs ---
# REQUIRED
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
# ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
# EXCHANGE_API_BASE_URL=https://api.frankfurter.dev
# HTTP_CONNECT_TIMEOUT_SECONDS=5
# HTTP_READ_TIMEOUT_SECONDS=10

# --- Fixed exchange rates (optional) ---
# EXCHANGE_MXN_USD=0.055000
# EXCHANGE_USD_MXN=18.000000

# --- Daily quotes batch (optional) ---
# BATCH_SYMBOLS=AAPL,TSLA,MSFT,AMZN,WMT
# BATCH_SCHEDULER_CRON=0 0 2 * * *
# BATCH_SCHEDULER_ZONE=UTC
# BATCH_SCHEDULER_ENABLED=true

# --- Demo data (optional) ---
# Set to true to load idempotent demo users, accounts, stocks, a position and history
# at startup (users demo.ana@example.com / demo.luis@example.com, password Demo1234!).
# Safe to leave on across restarts: existing records are never duplicated. Default false.
# SEED_DEMO_DATA=false
